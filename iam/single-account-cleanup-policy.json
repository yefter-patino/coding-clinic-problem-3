{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Read",
      "Effect": "Allow",
      "Action": ["ec2:DescribeVolumes", "ec2:DescribeSnapshots", "ec2:DescribeRegions"],
      "Resource": "*"
    },
    {
      "Sid": "SnapshotBeforeDelete",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": ["arn:aws:ec2:*:*:volume/*", "arn:aws:ec2:*::snapshot/*"]
    },
    {
      "Sid": "TagTheSnapshotsItCreates",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": { "StringEquals": { "ec2:CreateAction": "CreateSnapshot" } }
    },
    {
      "Sid": "DeleteVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:*:*:volume/*"
    }
  ]
}
