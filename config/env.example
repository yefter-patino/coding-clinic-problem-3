# Every command-line option can also be set with an environment variable.
# Copy this file to .env, edit the values, then load it with:
#   set -a; source .env; set +a
# Values given on the command line win over these.

EBS_CLEANUP_MIN_AGE_DAYS=30
EBS_CLEANUP_SCOPE=current                 # current | organization
EBS_CLEANUP_HOME_REGION=us-east-1
# EBS_CLEANUP_PROFILE=my-aws-profile
# EBS_CLEANUP_ROLE_NAME=yefter-ebs-audit  # needed for scope=organization
# EBS_CLEANUP_EXTERNAL_ID=
# EBS_CLEANUP_REGIONS=us-east-1,us-west-2  # empty = every enabled region
# EBS_CLEANUP_INCLUDE_ACCOUNTS=111111111111,222222222222
# EBS_CLEANUP_EXCLUDE_ACCOUNTS=333333333333
# EBS_CLEANUP_PROTECT_TAGS=do-not-delete,retain=true
# EBS_CLEANUP_REPORT_TAGS=Name,Owner,Project
# EBS_CLEANUP_PRICES_FILE=config/prices.json
# EBS_CLEANUP_OUTPUT_DIR=reports
# EBS_CLEANUP_WORKERS=4
# EBS_CLEANUP_NAME_PREFIX=yefter
# EBS_CLEANUP_SNAPSHOT_WAIT_MINUTES=60
# EBS_CLEANUP_MAX_PLAN_AGE_HOURS=24
